GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin a specific Gemini model.
# Leave unset to let ShipGuard pick the first available candidate
# (see MODEL_CANDIDATES in shipguard/config.py). Available models depend on
# your API key — list them with ai_service.discover_models().
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: point ShipGuard at a different dataset location
# (defaults to the sdoc-hackathon-bundle folder in the repo root).
# Accepts a folder path or an HTTP inbox URL.
# SHIPGUARD_DATA=D:\path\to\sdoc-hackathon-bundle

# Scoring only. The organizer package holds the answer key and therefore
# lives OUTSIDE this repository — never commit it. Point this at its
# data_v2/ground_truth.json to run scripts/score_submission.py.
# SHIPGUARD_GROUND_TRUTH=D:\path\to\sdoc-hackathon-docker\data_v2\ground_truth.json
#
# Optional: folder containing the organizers' scoring.py. Derived from the
# ground-truth path by default (../server).
# SHIPGUARD_SCORER=D:\path\to\sdoc-hackathon-docker\server
